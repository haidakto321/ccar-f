# Copy this file to labs/.env and fill in the key. labs/.env is git-ignored: never commit it.
# Keep the key HERE only. A global ANTHROPIC_API_KEY makes Claude Code bill the API instead of your Pro plan.
ANTHROPIC_API_KEY=

# Model for all labs. Haiku keeps cost low. Try claude-sonnet-5-5 or claude-opus-5-5 to compare
# (note: those two reject forced tool_choice, see lab 2).
CCAR_MODEL=claude-haiku-5-5
